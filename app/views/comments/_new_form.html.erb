<div
  class="w-full my-2 px-2 pb-1 bg-white rounded-sm shadow-sm"
  data-controller="remover"
>
  <% if @parent_id.nil? || @parent_id == "" %>
    <% id = "new_post_comment" %>
  <% else %>
    <% id = "reply_post_comment_#{@parent_id}_form" %>
  <% end %>
  <div id="<%= id %>">
    <div class=" text-xs text-red-600">
      <% if !@comment.errors.empty? %>
        <ul>
          <% @comment.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
    <%= form_with model: @comment, format: :turbo_stream do |f| %>
      <div>
        <%= f.hidden_field :parent_id, value: @parent_id %>
      </div>
      <div>
        <%= f.hidden_field :post_id, value: @post_id %>
      </div>
      <div>
        <%= f.label :body %>
        <%= f.rich_text_area :body %>
      </div>

      <div
        class="
          actions mt-4 text-white text-center bg-rose-400 rounded-sm accent-black
          active:bg-black
        "
      >
        <%= f.submit "Create Comment", class: "w-full p-2" %>
      </div>
    <% end %>
    <div
      class="
        my-2 p-1 border-1 text-center focus:bg-rose-400 focus:text-white
        hover:bg-rose-400 hover:text-white active:bg-black rounded-sm
      "
    >
      <button data-action="click->remover#remove" class="w-full">Cancel</button>
    </div>
  </div>
</div>
