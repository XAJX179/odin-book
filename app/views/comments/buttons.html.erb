<%= turbo_frame_tag dom_id(@comment, :buttons) do %>
  <% if @comment.author_id == current_user.id %>
    <div class="flex gap-1 justify-start items-center">
      <% if @comment.parent_id == nil %>
        <%= link_to "Edit",
        edit_post_comment_path(@post_id, @comment.id),
        data: {
          turbo_frame: dom_id(@comment),
        },
        class:
          "w-max my-2 px-4 py-2 outline-none rounded-sm border-2 border-rose-400 text-rose-400 focus:bg-rose-400 focus:text-white hover:bg-rose-400 hover:text-white" %>
      <% else %>
        <%= link_to "Edit",
        edit_post_comment_path(@post_id, @comment.id, parent_id: @comment.parent_id),
        data: {
          turbo_frame: dom_id(@comment),
        },
        class:
          "w-max my-2 px-4 py-2 outline-none rounded-sm border-2 border-rose-400 text-rose-400 focus:bg-rose-400 focus:text-white hover:bg-rose-400 hover:text-white" %>
      <% end %>

      <%= button_to post_comment_path(@post_id, @comment.id), method: :delete,
      class: "rounded-sm min-w-max mt-2 my-2 p-2 bg-red-600 text-white flex justify-center items-center active:scale-95" do %>
        <img
          class="max-w-[30%] pr-2"
          src="<%= image_url('icons/trash.svg') %>"
          alt="Delete Post"
          role="img"
        >
        <p>Delete</p>
      <% end %>
    </div>
  <% end %>
<% end %>
