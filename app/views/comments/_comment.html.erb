<%= turbo_frame_tag dom_id(comment),
  data: { controller: "toggle-replies", 
          toggle_replies_hidden_class: "replies--hidden", toggle_replies_show_toggle_class: "replies-toggle" },
          class: "bg-white my-2 p-2 rounded-sm shadow-sm border-l-2 border-gray-400" do %>
  <p class="flex items-center gap-1 py-2">
    <%= link_to user_profile_path(comment.author), data: { turbo_frame: "_top" }, class: "flex items-center gap-1" do %>
      <% if comment.author.profile.avatar.attached? %>
        <% if Rails.env.production? %>
          <%= image_tag cloudinary_url(comment.author.profile.avatar.key),
          class: "rounded-full size-10" %>
        <% else %>
          <%= image_tag url_for(comment.author.profile.avatar), class: "rounded-full size-10" %>
        <% end %>
      <% else %>
        <%= image_tag image_url("icons/user-default-pfp.svg"), class: "rounded-full size-10" %>
      <% end %>
      <span class="font-bold pl-1">
        <%= comment.author.profile.display_name %>
      </span>
      <span class="text-gray-400 text-sm pr-1">
        @<%= comment.author.name %>
      </span>
    <% end %>
    <span class="text-xs text-gray-500">
      <%= time_ago_in_words comment.created_at %>
      ago
    </span>
  </p>
  <% if local_assigns[:show] %>
    <%= comment.body %>
  <% else %>
    <%= link_to post_comment_path(comment.post_id, comment.id, new_tlc: comment.id),
  data: {
    turbo_frame: "_top",
    turbo_prefetch: "false",
  }, class: "max-h-[40vh] overflow-hidden" do %>
      <%= comment.body %>
    <% end %>

    <%= link_to post_comment_path(comment.post_id, comment.id, new_tlc: comment.id),
  data: {
    turbo_frame: "_top",
    turbo_prefetch: "false",
  } do %>
      <p class="text-gray-400 text-center text-xs pt-1">Click to Expand</p>
    <% end %>
  <% end %>
  <%= link_to new_post_comment_path(comment.post_id, parent_id: comment.id),
  data: {
    turbo_frame: dom_id(comment, :reply),
  } ,class: "bg-white text-rose-400 p-2 mb-2 w-max rounded-sm shadow-sm" do %>

    <%= image_tag "icons/reply.svg", class: "size-6 inline", alt: "Reply comment" %>
    <span>Reply</span>
  <% end %>
  <%= turbo_frame_tag dom_id(comment, :buttons),
  src: buttons_post_comment_path(comment.post_id,comment.id), lazy: :loading do %>
    loading buttons...
  <% end %>
  <%= turbo_frame_tag dom_id(comment, :reply) %>
  <% if comment.replies.exists? %>
    <%= render partial: "comments/show_reply_button", locals: { comment: comment } %>
  <% end %>
<% end %>
