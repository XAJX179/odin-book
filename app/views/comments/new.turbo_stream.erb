<% if @parent_id.nil? || @parent_id == "" %>
  <%= turbo_stream.update "new_comment" do %>
    <%= render partial: "new_form" %>
  <% end %>
<% else %>
  <%= turbo_stream.update "reply_post_comment_#{parent_id}" do %>
    <%= render partial: "new_form" %>
  <% end %>
<% end %>
<%= turbo_stream.update("flash", partial: "shared/flash") %>
