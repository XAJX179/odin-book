<%= turbo_stream.replace dom_id(@parent_comment, :replies_toggle) do %>
  <%= tag.button "Hide Replies",
             id: dom_id(@parent_comment, :replies_toggle),
             data: {
               action: "click->toggle-replies#hide",
             }, class: "w-max p-2 my-2 rounded-full bg-white text-rose-400 outline-none border-rose-400 border-1" %>
<% end %>
<%= turbo_stream.append dom_id(@parent_comment) do %>
  <%= tag.div id: dom_id(@parent_comment, :replies_to) , class: "comment-replies",
    data: {
      toggle_replies_target: "replies"
    } do %>
    <%= turbo_frame_tag "#{@parent_comment.id}-replies-loader",
    loading: "lazy", 
    src: load_replies_to_post_comment_path(@post.id, @parent_comment.id, new_tlc: @new_tlc, format: "turbo_stream") do %>
      <%= render "shared/posts/loader" %>
    <% end %>
  <% end %>
<% end %>
