<%= turbo_stream.before "#{@parent_comment.id}-replies-loader" do %>
  <% @replies.each do |reply| %>
    <%= render partial: "comments/comment", locals: { comment: reply } %>
  <% end %>
<% end %>

<%= turbo_stream.replace "#{@parent_comment.id}-replies-loader" do %>
  <% shift = PostComment::LIMIT %>
  <%= link_to "Load More",
  load_replies_to_post_comment_path(
    @post.id,
    @parent_comment.id,
    offset: @offset.to_i + shift,
    new_tlc: @new_tlc,
    format: "turbo_stream",
  ),
  data: {
    turbo_prefetch: "false",
  },
  id: "#{@parent_comment.id}-replies-loader" %>
<% end %>
