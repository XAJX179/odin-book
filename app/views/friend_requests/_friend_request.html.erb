<div
  id="<%= dom_id(friend_request) %>"
  class="bg-white shadow-sm rounded-sm my-2 p-2"
>
  <div class='flex flex-col md:flex-row justify-between'>
    <div>
      <% if friend_request.to_id == user_id %>
        <%= link_to user_profile_path(friend_request.from), data: { turbo_frame: "_top" } do %>
          <% if friend_request.from.profile.avatar.attached? %>
            <% if Rails.env.production? %>
              <%= image_tag cloudinary_url(friend_request.from.profile.avatar.key),
              class: "rounded-full size-10" %>
            <% else %>
              <%= image_tag url_for(friend_request.from.profile.avatar),
              class: "rounded-full size-10" %>
            <% end %>
          <% else %>
            <%= image_tag image_url("icons/user-default-pfp.svg"), class: "rounded-full size-10" %>
          <% end %>

          <div>
            <p class="font-bold text-base pl-1">
              <%= truncate(friend_request.from.profile.display_name, length: 25) %>
            </p>
            <p class="text-sm text-gray-400">
              @<%= truncate(friend_request.from.name, length: 25) %>
            </p>
          </div>
        <% end %>
      <% else %>
        <%= link_to user_profile_path(friend_request.to), data: { turbo_frame: "_top" } do %>
          <% if friend_request.to.profile.avatar.attached? %>
            <% if Rails.env.production? %>
              <%= image_tag cloudinary_url(friend_request.to.profile.avatar.key),
              class: "rounded-full size-10" %>
            <% else %>
              <%= image_tag url_for(friend_request.to.profile.avatar),
              class: "rounded-full size-10" %>
            <% end %>
          <% else %>
            <%= image_tag image_url("icons/user-default-pfp.svg"), class: "rounded-full size-10" %>
          <% end %>

          <div>
            <p class="font-bold text-base pl-1">
              <%= truncate(friend_request.to.profile.display_name, length: 25) %>
            </p>
            <p class="text-sm text-gray-400">
              @<%= truncate(friend_request.to.name, length: 25) %>
            </p>
          </div>
        <% end %>
      <% end %>
    </div>
    <div class="flex flex-col">
      <% if friend_request.from_id == user_id %>
        <%= button_to friend_request_path(friend_request), method: :delete, form: {data: { turbo_confirm: "Are you sure?"}},
          class: "rounded-sm min-w-max mt-2 p-2 bg-red-600 text-white flex justify-center items-center active:scale-95" do %>

          <img
            class="max-w-[30%] pr-2"
            src="<%= image_url('icons/remove-friend.svg') %>"
            alt="Cancel Friend Request"
            role="img"
          >
          <p>Cancel Request</p>
        <% end %>
      <% else %>
        <%= button_to accept_friend_request_path(friend_request) ,class: "rounded-sm min-w-max mt-2 p-2 bg-rose-400 text-white flex justify-center items-center active:scale-95" do %>
          <%= image_tag "icons/add-friend.svg", class: "max-w-[30%] pr-2", alt: "Send Request" %>
          <p>Accept Request</p>
        <% end %>
        <%= button_to friend_request_path(friend_request), method: :delete, form: {data: { turbo_confirm: "Are you sure?"}},
          class: "rounded-sm min-w-max mt-2 p-2 bg-red-600 text-white flex justify-center items-center active:scale-95" do %>
          <%= image_tag "icons/remove-friend.svg",
          class: "max-w-[30%] pr-2",
          alt: "Reject Request" %>
          <p>Reject Request</p>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
