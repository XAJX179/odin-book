<div
  class="
    w-[90%] sm:max-w-[80%] md:max-w-[60%] lg:max-w-[50%] max-w-[90%] min-w-[50%]
    pb-50
  "
>
  <h2 class="font-mono text-xl p-2 text-center">Friend Requests</h2>

  <div class="flex gap-1 my-2">
    <%= link_to "Incoming",
    incoming_friend_requests_path,
    data: {
      turbo_frame: "friend-requests",
    },
    class:
      "my-auto px-4 py-2 outline-none rounded-sm border-2 border-rose-400 text-rose-400 focus:bg-rose-400 focus:text-white hover:bg-rose-400 hover:text-white " %>
    <%= link_to "Outgoing",
    outgoing_friend_requests_path,
    data: {
      turbo_frame: "friend-requests",
    },
    class:
      "my-auto px-4 py-2 outline-none rounded-sm border-2 border-rose-400 text-rose-400 focus:bg-rose-400 focus:text-white hover:bg-rose-400 hover:text-white " %>
  </div>

  <%= turbo_frame_tag "friend-requests", src: incoming_friend_requests_path %>
</div>
