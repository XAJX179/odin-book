<% if turbo_frame_request_id&.first(13) == "search_result" || defined? search_result %>
  <% id = "search_result_user_#{user.id}_profile_action_button" %>
<% else %>
  <% id = "user_#{user.id}_profile_action_button" %>
<% end %>
<%= turbo_frame_tag id do %>
  <%= button_to friend_requests_path(friend_request: { to: user.name }),
    form: {data: { turbo_confirm: "Are you sure?"}},
    class: "rounded-sm min-w-max mt-2 p-2 bg-rose-400 text-white flex justify-center items-center active:scale-95" do %>
    <%= image_tag "icons/add-friend.svg", class: "max-w-[30%] pr-2", alt: "Send Request" %>
    <p>Send Request</p>
  <% end %>
<% end %>
