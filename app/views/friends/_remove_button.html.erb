<% if turbo_frame_request_id&.first(13) == "search_result"|| defined? search_result %>
  <% id = "search_result_user_#{user.id}_profile_action_button" %>
<% else %>
  <% id = "user_#{user.id}_profile_action_button" %>
<% end %>
<%= turbo_frame_tag id do %>
  <%= button_to user_friend_path(user_id: current_user.id, id: user.id),
          form: {data: { turbo_confirm: "Are you sure?"}},
          method: :delete,
          class: "rounded-sm min-w-max mt-2 p-2 bg-red-600 text-white flex justify-center items-center active:scale-95" do %>

    <%= image_tag "icons/trash.svg", class: "max-w-[30%] pr-2", alt: "Remove Friend" %>
    <p>Remove Friend</p>
  <% end %>
<% end %>
