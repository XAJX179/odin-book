<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Odin Book" %></title>

    <%= action_cable_meta_tag %>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-fuchsia-50 ">
    <a href="https://github.com/XAJX179/odin-book" class="flex justify-center">
      <% if current_user %>
        <h1 class=" items-center flex gap-1">
          <img src="<%=  image_url("icon.svg") %>" alt="logo" class="w-15">
          <div class="font-mono">
            <p>
              Odin Book
            </p>
            <p class="text-xs">
              by XAJX179
            </p>
          </div>
        </h1>
      <% else %>
        <h1 class="absolute left-1 top-1 text-center">
          <img src="<%=  image_url("icon.svg") %>" alt="logo" class="w-15 mx-auto">
          <div class="font-mono">
            <p>
              Odin Book
            </p>
            <p class="text-xs">
              by XAJX179
            </p>
          </div>
        </h1>
      <% end %>
    </a>
    <% if current_user %>
      <nav
        class="
          flex md:flex-col fixed left-0 right-0 bottom-0 md:right-auto md:top-0
          md:justify-center z-1 mx-auto gap-3 md:gap-6 p-3 bg-white max-w-max rounded-2xl
          shadow-sm
        "
      >
        <%= link_to  users_path, class: "group relative hover:bg-gray-100 rounded-full p-2 bg-gray-50" do %>
          <img
            src="<%= image_url("icons/user-search.svg") %>"
            alt="User search"
            class="size-6"
          >
          <p
            class="
              hidden md:group-hover:block md:group-focus-visible:block absolute right-auto
              top-0 left-13 py-3 px-2 text-sm bg-white text-gray-600 rounded-full shadow-sm
              w-max
            "
          >User search</p>
        <% end %>
        <%= link_to  user_friends_path(user_id: current_user.id), class: "group relative hover:bg-gray-100 rounded-full p-2 bg-gray-50" do %>
          <img
            src="<%= image_url("icons/users-round.svg") %>"
            alt="Friends"
            class="size-6"
          >
          <p
            class="
              hidden md:group-hover:block md:group-focus-visible:block absolute right-auto
              left-13 top-0 py-3 px-2 text-sm bg-white text-gray-600 rounded-full shadow-sm
              w-max
            "
          >Friends</p>
        <% end %>
        <%= link_to  posts_path , class: "group relative hover:bg-gray-100 rounded-full p-2 bg-gray-50" do %>
          <img src="<%= image_url("icons/scroll-text.svg") %>" alt="Posts" class="size-6">

          <p
            class="
              hidden md:group-hover:block md:group-focus-visible:block absolute right-auto
              top-0 left-13 py-3 px-3 text-sm bg-white text-gray-600 rounded-full shadow-sm
              w-max
            "
          >Posts</p>
        <% end %>
        <%= link_to  friend_requests_path, class: "group relative hover:bg-gray-100 rounded-full p-2 bg-gray-50" do %>
          <img
            src="<%= image_url("icons/friend-req.svg") %>"
            alt="Friend requests"
            class="size-6"
          >

          <p
            class="
              hidden md:group-hover:block md:group-focus-visible:block absolute right-auto
              top-0 left-13 py-3 px-2 text-sm bg-white text-gray-600 rounded-full shadow-sm
              w-max
            "
          >Friend requests</p>
        <% end %>
        <%= link_to  user_profile_path(user_id: current_user.id), class: "group relative hover:bg-gray-100 rounded-full p-2 bg-gray-50" do %>
          <img
            src="<%= image_url("icons/square-pen.svg") %>"
            alt="Profile"
            class="size-6"
          >

          <p
            class="
              hidden md:group-hover:block md:group-focus-visible:block absolute right-auto
              top-0 left-13 py-3 px-2 text-sm bg-white text-gray-600 rounded-full shadow-sm
              w-max
            "
          >Profile</p>
        <% end %>
      </nav>
    <% end %>
    <div
      id="flash"
      class="
        fixed text-center text-white text-sm mx-2 right-0 top-2 sm:right-5 sm:top-10 z-1
      "
    >
      <%= render "shared/flash" %>
    </div>
    <div class="flex flex-col items-center justify-center min-h-full">
      <%= yield %>
    </div>
  </body>
</html>
