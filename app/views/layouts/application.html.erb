<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Odin Book" %></title>

    <%= action_cable_meta_tag %>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-fuchsia-50 ">
    <% if current_user %>
      <nav
        class="
          flex fixed left-0 right-0 bottom-0 z-1 mx-auto gap-3 md:gap-6 p-3 bg-white
          max-w-max rounded-2xl shadow-sm
        "
      >
        <%= link_to  users_path, class: "hover:bg-gray-100 rounded-full p-2 bg-gray-50" do %>
          <img
            src="<%= image_url("icons/user-search.svg") %>"
            alt="User search"
            class="size-6"
          >
        <% end %>
        <%= link_to  user_friends_path(user_id: current_user.id), class: "hover:bg-gray-100 rounded-full p-2 bg-gray-50" do %>
          <img
            src="<%= image_url("icons/users-round.svg") %>"
            alt="Friends"
            class="size-6"
          >
        <% end %>
        <%= link_to  posts_path , class: "hover:bg-gray-100 rounded-full p-2 bg-gray-50" do %>
          <img
            src="<%= image_url("icons/scroll-text.svg") %>"
            alt="Posts"
            class="size-6"
          >
        <% end %>
        <%= link_to  friend_requests_path, class: "hover:bg-gray-100 rounded-full p-2 bg-gray-50" do %>
          <img
            src="<%= image_url("icons/friend-req.svg") %>"
            alt="Friend requests"
            class="size-6"
          >
        <% end %>
        <%= link_to  user_profile_path(user_id: current_user.id), class: "hover:bg-gray-100 rounded-full p-2 bg-gray-50" do %>
          <img
            src="<%= image_url("icons/square-pen.svg") %>"
            alt="Profile"
            class="size-6"
          >
        <% end %>
      </nav>
    <% end %>
    <div
      id="flash"
      class="
        fixed text-center text-white text-sm mx-2 right-0 top-2 sm:right-5 sm:top-10
      "
    >
      <%= render "shared/flash" %>
    </div>
    <div class="flex flex-col items-center justify-center min-h-full pb-50">
      <%= yield %>
    </div>
  </body>
</html>
