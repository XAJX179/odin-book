<div class="text-center text-rose-400 px-2 m-2 max-w-full">
  <div class="text-xs ">
    <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
      <p><%= link_to "Forgot your password?", new_password_path(resource_name) %></p>
    <% end %>

    <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
      <p><%= link_to "Didn't receive verification link?",
        new_confirmation_path(resource_name) %></p>
    <% end %>

    <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
      <p><%= link_to "Didn't receive unlock instructions?", new_unlock_path(resource_name) %></p>
    <% end %>
  </div>

  <div class="flex flex-col mt-1">
    <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
      <p><%= link_to "Sign up",
        new_registration_path(resource_name),
        class:
          "rounded-sm outline-2 p-1 focus:outline-black focus:bg-rose-400 focus:text-white hover:bg-rose-400 hover:text-white active:bg-black" %></p>
    <% end %>

    <%- if controller_name != 'sessions' %>
      <p><%= link_to "Log in",
        new_session_path(resource_name),
        class:
          "rounded-sm mt-2 outline-2 p-1 focus:outline-black focus:bg-rose-400 focus:text-white hover:bg-rose-400 hover:text-white active:bg-black" %></p>
    <% end %>
    <%- if devise_mapping.omniauthable? %>
      <%- resource_class.omniauth_providers.each do |provider| %>
        <div>
          <% if provider == :github %>

            <%= button_to omniauth_authorize_path(resource_name, provider),
            data: {
              turbo: false,
            },
            class: "rounded-sm min-w-full mt-2 p-2 bg-black text-white flex justify-center items-center active:scale-95" do %>
              <img
                class="max-w-[15%] md:max-w-[10%] 2xl:max-w-[5%] pr-2"
                src="<%= image_url('icons/GitHub_Invertocat_White_Clearspace.svg') %>"
                alt="Login"
                role="img"
              >
              <p>Login with
                <%= OmniAuth::Utils.camelize(provider) %></p>
            <% end %>
          <% else %>

            <%= button_to omniauth_authorize_path(resource_name, provider),
            data: {
              turbo: false,
            },
            class: "rounded-sm min-w-full mt-2 p-2 bg-indigo-500 text-white flex justify-center items-center active:scale-95" do %>
              <img
                class="max-w-[15%] md:max-w-[10%] 2xl:max-w-[5%] pr-2"
                src="<%= image_url('icons/Discord-Symbol-White.png') %>"
                alt="Login"
                role="img"
              >
              <p>Login with
                <%= OmniAuth::Utils.camelize(provider) %></p>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
