<%= turbo_frame_tag "profile" do %>

  <div class=" text-xs text-red-600">
    <% if !@profile.errors.empty? %>
      <ul>
        <% @profile.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
  <%= form_with model: @profile, url: :user_profile, data: {turbo_frame: "_top"} do |f| %>
    <div class="flex items-center gap-1 my-5">
      <%= f.label :avatar,
              "Choose new avatar image",
              class: "bg-gray-100 p-2 border-b-1 border-rose-400 rounded-sm shadow-sm" %>
      <%= f.file_field :avatar, class: "text-sm text-gray-400" %>
    </div>
    <div class="my-10 relative">
      <%= f.text_field :display_name,
                   placeholder: "your name",
                   class:
                     "peer w-full placeholder-transparent border-b-2 focus:outline-none focus:border-rose-400" %>
      <%= f.label :display_name,
              "Name",
              class:
                "absolute left-0 top-0 peer-not-placeholder-shown:-top-4 peer-not-placeholder-shown:text-sm peer-focus:-top-4 peer-focus:text-sm text-gray-600 transition-all" %>
    </div>
    <div class="my-10 relative">
      <%= f.text_field :about,
                   placeholder: "About...",
                   class:
                     "peer w-full placeholder-transparent border-b-2 focus:outline-none focus:border-rose-400" %>
      <%= f.label :about,
              class:
                "absolute left-0 top-0 peer-not-placeholder-shown:-top-4 peer-not-placeholder-shown:text-sm peer-focus:-top-4 peer-focus:text-sm text-gray-600 transition-all" %>
    </div>
    <div
      class="
        actions mt-4 text-white text-center bg-rose-400 rounded-sm accent-black
        active:bg-black
      "
    >
      <%= f.submit "Update Profile", class: "w-full p-2" %>
    </div>
  <% end %>

  <%= link_to "Cancel",
  user_profile_path(user_id: current_user.id),
  class:
    "my-2 p-1 border-1 text-center focus:bg-rose-400 focus:text-white hover:bg-rose-400 hover:text-white active:bg-black rounded-sm" %>
<% end %>
