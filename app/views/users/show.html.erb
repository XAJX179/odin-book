<div
  class="
    w-[90%] sm:max-w-[80%] md:max-w-[60%] lg:max-w-[50%] max-w-[90%] min-w-[50%]
    pb-50
  "
>
  <h2 class="font-mono text-xl p-2 text-center">
    Profile
  </h2>

  <%= link_to  destroy_user_session_path, data: { turbo_method: :delete },class: "hover:bg-gray-100 rounded-full p-2 bg-white w-max my-2" do %>
    <div class="flex gap-1">
      <img src="<%= image_url("icons/log-out.svg") %>" alt="Logoout" role="img">
      <p>Sign out</p>
    </div>
  <% end %>

  <div
    class="
      bg-white py-2 px-4 rounded-sm shadow-sm border-x-3 border-rose-400 mb-3
    "
  >
    <%= turbo_frame_tag "profile" do %>
      <div class="flex justify-between gap-2 p-2 items-center">
        <div class="flex items-center gap-2">
          <% if @user.profile.avatar.attached? %>
            <% if Rails.env.production? %>
              <%= image_tag cloudinary_url(@user.profile.avatar.key),
              class: "rounded-full size-20" %>
            <% else %>
              <%= image_tag url_for(@user.profile.avatar), class: "rounded-full size-20" %>
            <% end %>
          <% else %>
            <%= image_tag image_url("icons/user-default-pfp.svg"), class: "rounded-full size-10" %>
          <% end %>

          <div>
            <p class="font-bold text-xl pl-1">
              <%= @user.profile.display_name %>
            </p>
            <p class="text-sm text-gray-400">
              @<%= @user.name %>
            </p>
          </div>
        </div>
        <div class="flex flex-col justify-center items-center">
          <% if @user == current_user %>
            <%= link_to "Edit",
            edit_user_profile_path(@user),
            class:
              "w-max my-2 px-4 py-2 outline-none rounded-sm border-2 border-rose-400 text-rose-400 focus:bg-rose-400 focus:text-white hover:bg-rose-400 hover:text-white" %>
          <% end %>
        </div>
      </div>
      <%= render partial: "buttons", locals: { user: @user, requests: @requests } %>
      <p>
        <%= @user.profile.about %>
      </p>
    <% end %>
  </div>

  <%= link_to "View Friends",
  user_friends_path(@user),
  class:
    "w-max px-4 py-2 my-4 text-white text-center bg-rose-400 rounded-sm accent-black active:bg-black" %>

  <%= turbo_stream_from "profile_#{@user.id}_viewer_#{current_user.id}" %>

  <%= turbo_frame_tag "profile-posts",
loading: "lazy",
src: posts_index_for_user_path(id: @user.id) do %>
    <%= render "shared/posts/loader" %>
  <% end %>
</div>
