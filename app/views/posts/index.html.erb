<div
  class="
    w-[90%] sm:max-w-[80%] md:max-w-[60%] lg:max-w-[50%] max-w-[90%] min-w-[50%]
    pb-50
  "
>
  <h2 class="font-mono text-xl p-2 text-center">Posts</h2>
  <%= link_to "New Post",
  new_post_path,
  data: {
    turbo_frame: "_top",
  },
  class:
    "actions w-max px-4 py-2 my-4 text-white text-center bg-teal-600 rounded-sm accent-black active:bg-black" %>

  <%= tag.div data: {
              controller: "search",
              search_url_value: search_posts_url,
              } ,class: "bg-white relative rounded-sm shadow-sm" do %>

    <img
      class="absolute left-2 top-2 max-w-[15%] md:max-w-[10%] pr-2"
      src="<%= image_url('icons/search.svg') %>"
      alt="Search"
      role="img"
    >
    <%= text_field_tag :title,
    "",
    placeholder: "Search posts by title",
    data: {
      action: "keyup->search#fetchResults",
      search_target: "searchField",
    },
    autofocus: true,
    autocomplete: "off",
    class:
      "py-1 pl-10 w-full accent-rose-500 focus:border-rose-500 border-b-1 rounded-sm outline-none" %>
    <div data-search-target="results"></div>
  <% end %>

  <div class="flex gap-1 my-2">
    <%= link_to "All",
    all_posts_path,
    data: {
      turbo_frame: "posts",
    },
    class:
      "my-auto px-4 py-2 outline-none rounded-sm border-2 border-rose-400 text-rose-400 focus:bg-rose-400 focus:text-white hover:bg-rose-400 hover:text-white " %>
    <%= link_to "Feed",
    feed_posts_path,
    data: {
      turbo_frame: "posts",
    },
    class:
      "my-auto px-4 py-2 outline-none rounded-sm border-2 border-rose-400 text-rose-400 focus:bg-rose-400 focus:text-white hover:bg-rose-400 hover:text-white " %>
  </div>

  <%= turbo_frame_tag "posts", src: all_posts_path do %>
    <%= render "shared/posts/loader" %>
  <% end %>
</div>
