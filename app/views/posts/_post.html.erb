<%# for index posts %>
<%= link_to post_path(post), data: { turbo_frame: "_top" },
id: controller.action_name == "search" ? dom_id(post,:search_result) : dom_id(post),
class: "bg-white rounded-sm shadow-sm my-2" do %>
  <div class="post p-2">
    <p class="flex items-center gap-1">
      <% if post.author.profile.avatar.attached? %>
        <% if Rails.env.production? %>
          <%= image_tag cloudinary_url(post.author.profile.avatar.key),
          class: "rounded-full size-10" %>
        <% else %>
          <%= image_tag url_for(post.author.profile.avatar), class: "rounded-full size-10" %>
        <% end %>
      <% else %>
        <%= image_tag image_url("icons/user-default-pfp.svg"), class: "rounded-full size-10" %>
      <% end %>
      <span class="flex flex-col">
        <span class="font-bold pl-1">
          <%= truncate(post.author.profile.display_name, length: 17) %>
        </span>
        <span class="text-gray-400 text-sm pr-1">
          @<%= truncate(post.author.name, length: 17) %>
        </span>
      </span>
      <span class="text-xs text-gray-500 bg-white">
        <%= time_ago_in_words post.created_at %>
        ago
      </span>
    </p>
    <p class="text-lg font-sans font-extrabold pb-1 break-all">
      <%= post.title %>
    </p>
    <div class="px-2">
      <% if !post.body.embeds.attachments.empty? %>
        <%= render partial: "active_storage/blobs/blob",
        locals: {
          blob: post.body.embeds.attachments.first.blob,
        } %>
        <p class="text-gray-400 text-center text-xs pt-1">Click to Expand</p>
      <% else %>
        <div class="max-h-[40vh] overflow-hidden">
          <%= post.body %>
        </div>
      <% end %>
    </div>
    <div class="flex gap-2 py-2">
      <p class="flex gap-2">
        <img src="<%= image_url('icons/heart-filled.svg') %>" alt="Number of likes">
        <span>
          <%= post.post_likes.size %>
        </span>
      </p>
      <p class="flex gap-2">
        <img
          src="<%= image_url('icons/message-square.svg') %>"
          alt="Number of comments"
        >
        <span>
          <%= post.post_comments.size %>
        </span>
      </p>
    </div>
  </div>
<% end %>
